# Copy to `.env` and adjust if your host ports are already taken.
# Compose reads POSTGRES_* / REDIS_PORT. The app reads DATABASE_URL / REDIS_URL / APP_URL.

POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence
# Host ports. 5432/6379 are often taken by other Compose projects.
POSTGRES_PORT=5435
REDIS_PORT=6380

DATABASE_URL=postgresql://cadence:cadence@localhost:5435/cadence
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3000
# Set true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false

# Seeded admin (used by `pnpm db:seed` only). Add these if you already have a .env.
ADMIN_EMAIL=admin@cadence.local
ADMIN_PASSWORD=cadence-admin
